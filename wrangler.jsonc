{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "israeli-stay-prices",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stay-prices",
      // Fill in after: npx wrangler d1 create stay-prices
      "database_id": "f6e84594-5969-4ed2-b10d-f100bbc07cce",
      "migrations_dir": "migrations"
    }
  ],
  // Per-IP request limits (Workers Rate Limiting). Counters live in memory at the edge; nothing is stored.
  "ratelimits": [
    { "name": "RL_API", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_WRITE", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  "vars": {
    "GOOGLE_CLIENT_ID": "735783155997-4sjga78glpmapvk9ulk1pjcl2re43ljn.apps.googleusercontent.com",
    "APP_URL": "https://israeli-stay-prices.hyuval1511.workers.dev"
  }
  // Secret (not in git): npx wrangler secret put GOOGLE_CLIENT_SECRET
}
